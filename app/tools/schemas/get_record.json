{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "description": "All-time records: single-game highs, best seasons, titles.",
 "properties": {
  "record": {
   "type": "string",
   "enum": [
    "most_points_game",
    "most_threes_game",
    "most_rebounds_game",
    "most_assists_game",
    "career_triple_doubles",
    "best_regular_season_record",
    "most_championships"
   ]
  },
  "limit": {
   "type": "integer",
   "minimum": 1,
   "maximum": 10,
   "default": 1
  }
 },
 "required": [
  "record"
 ],
 "additionalProperties": false
}
