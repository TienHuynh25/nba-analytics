{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "description": "Regular-season standings, league-wide or for one conference.",
 "properties": {
  "season": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}$",
   "description": "e.g. 2025-26"
  },
  "conference": {
   "type": "string",
   "enum": [
    "East",
    "West"
   ]
  },
  "limit": {
   "type": "integer",
   "minimum": 1,
   "maximum": 30
  }
 },
 "required": [
  "season"
 ],
 "additionalProperties": false
}
