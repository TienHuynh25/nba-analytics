-- 2025-26 games by season type
   select season_type, is_cup_final, count(*), min(game_date), max(game_date) from marts.games where season='2025-26' group by all order by 1,2
   ('Cup Final', True, 1, datetime.date(2025, 12, 16), datetime.date(2025, 12, 16))
   ('Regular Season', False, 1230, datetime.date(2025, 10, 21), datetime.date(2026, 4, 12))
-- latest game date per table
   select 'games', max(game_date) from marts.games union all
 select 'player_game', max(game_date) from marts.player_game union all
 select 'shots', max(game_date) from marts.shots union all
 select 'records.valid_from', max(valid_from) from marts.records
   ('games', datetime.date(2026, 4, 12))
   ('player_game', datetime.date(2026, 4, 12))
   ('shots', datetime.date(2026, 4, 12))
   ('records.valid_from', datetime.date(2026, 3, 10))
