-- team_season 2025-26 RS: sum wins = sum losses = 1230, gp all 82
   select sum(wins), sum(losses), min(gp), max(gp), count(*) from marts.team_season where season='2025-26' and season_type='Regular Season'
   (1230, 1230, 82, 82, 30)
-- 2025-26 RS leaders pts/g (gp>=58 approx 70%)
   select p.name, ps.gp, round(ps.pts/ps.gp,1) from marts.player_season ps join marts.players p using(player_id)
     where season='2025-26' and season_type='Regular Season' and gp >= 58 order by ps.pts/ps.gp desc limit 3
   ('Luka Dončić', 64, 33.5)
   ('Shai Gilgeous-Alexander', 68, 31.1)
   ('Anthony Edwards', 61, 28.8)
-- 2025-26 RS leaders reb/g (gp>=58 approx 70%)
   select p.name, ps.gp, round(ps.reb/ps.gp,1) from marts.player_season ps join marts.players p using(player_id)
     where season='2025-26' and season_type='Regular Season' and gp >= 58 order by ps.reb/ps.gp desc limit 3
   ('Nikola Jokić', 65, 12.9)
   ('Karl-Anthony Towns', 75, 11.9)
   ('Donovan Clingan', 77, 11.6)
-- 2025-26 RS leaders ast/g (gp>=58 approx 70%)
   select p.name, ps.gp, round(ps.ast/ps.gp,1) from marts.player_season ps join marts.players p using(player_id)
     where season='2025-26' and season_type='Regular Season' and gp >= 58 order by ps.ast/ps.gp desc limit 3
   ('Nikola Jokić', 65, 10.7)
   ('Cade Cunningham', 64, 9.9)
   ('Luka Dončić', 64, 8.3)
-- semantic player_career_stats LeBron
   select season_type, seasons, last_season, games_played, points, rebounds, assists from semantic.player_career_stats where player_id=2544 order by 1
   ('Playoffs', 18, '2024-25', 292, 8289, 2628, 2095)
   ('Regular Season', 23, '2025-26', 1622, 43440, 12095, 12016)
-- sum(player_season) LeBron
   select season_type, count(*), max(season), sum(gp), sum(pts), sum(reb), sum(ast) from marts.player_season where player_id=2544 group by 1 order by 1
   ('Playoffs', 18, '2024-25', 292, 8289, 2628, 2095)
   ('Regular Season', 23, '2025-26', 1622, 43440, 12095, 12016)
-- dev build (all cached data): LeBron playoffs through 2024-25
   select season_type, count(*), max(season), sum(gp), sum(pts), sum(reb), sum(ast) from marts.player_season where player_id=2544 and season <= '2024-25' and season_type='Playoffs' group by 1
   ('Playoffs', 18, '2024-25', 292, 8289, 2628, 2095)
-- dev build: LeBron playoffs, all seasons
   select season_type, count(*), max(season), sum(gp), sum(pts), sum(reb), sum(ast) from marts.player_season where player_id=2544 and season_type='Playoffs' group by 1
   ('Playoffs', 19, '2025-26', 302, 8521, 2695, 2168)
-- career identity: all players, semantic career vs sum(player_season) mismatches
   with s as (select player_id, season_type, sum(gp) gp, sum(pts) pts, sum(reb) reb, sum(ast) ast from marts.player_season group by all)
 select count(*) filter (where c.games_played is distinct from s.gp or c.points is distinct from s.pts or c.rebounds is distinct from s.reb or c.assists is distinct from s.ast), count(*)
 from semantic.player_career_stats c join s using (player_id, season_type)
   (0, 7842)
