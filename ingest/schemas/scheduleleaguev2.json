{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "scheduleleaguev2",
 "$comment": "Hand-written (not a resultSets body). Only the fields the anomaly check (1.8) reads.",
 "type": "object",
 "required": ["leagueSchedule"],
 "properties": {
  "leagueSchedule": {
   "type": "object",
   "required": ["gameDates"],
   "properties": {
    "gameDates": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": ["gameDate", "games"],
      "properties": {
       "gameDate": {"type": "string", "pattern": "^\\d{2}/\\d{2}/\\d{4}"},
       "games": {
        "type": "array",
        "items": {
         "type": "object",
         "required": ["gameId", "gameStatus"],
         "properties": {
          "gameId": {"type": "string", "pattern": "^\\d{10}$"},
          "gameStatus": {"type": "integer"}
         }
        }
       }
      }
     }
    }
   }
  }
 }
}
